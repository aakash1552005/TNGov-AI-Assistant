# ─── Application ───────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/tngov
CHROMA_DB_PATH=./chroma_db
MODEL_NAME=gpt-4.1
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# ─── Retrieval Tuning ─────────────────────────────────────────
RETRIEVAL_VECTOR_TOP_K=5
RETRIEVAL_BM25_TOP_K=5
RETRIEVAL_FINAL_CONTEXT_K=4
RETRIEVAL_MIN_SCORE=0.15
RRF_K=60
BM25_INDEX_PATH=./bm25_index.json

# ─── LLM Configuration ─────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here
MODEL_NAME=gpt-4.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
MAX_QUERY_LENGTH=500

# ─── PostgreSQL (Docker) ──────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tngov
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Backend ──────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# ─── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
