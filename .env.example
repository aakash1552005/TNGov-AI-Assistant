# =============================================================================
# .env.example — Root Environment Variable Reference (Docker Compose)
# =============================================================================
# This file documents variables used by docker-compose.yml.
# The backend service reads from backend/.env (see backend/.env.example).
#
# Copy to .env for local development:
#   cp .env.example .env
# =============================================================================

# ─── PostgreSQL (Docker local only) ──────────────────────────────────────────
# These variables configure the local Docker PostgreSQL container.
# In production (Railway), DATABASE_URL is auto-injected by the plugin.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=tngov_ai
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── Backend ──────────────────────────────────────────────────────────────────
# Used by the backend service inside Docker Compose.
# Full backend configuration is in backend/.env (see backend/.env.example).
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_pass@db:5432/tngov_ai

# ─── Frontend ─────────────────────────────────────────────────────────────────
# URL the frontend uses to reach the backend API.
# Local development: http://localhost:8000
# Production (Vercel): set NEXT_PUBLIC_API_URL in Vercel project settings.
NEXT_PUBLIC_API_URL=http://localhost:8000
