# =============================================================================
# backend/.env.example — Environment Variable Reference
# =============================================================================
# Copy to backend/.env and populate real values (never commit .env to git).
#
# CLOUD DEPLOYMENT (Railway):
#   Set these variables in Railway → Service → Variables dashboard.
#   DATABASE_URL is auto-injected by the Railway PostgreSQL plugin.
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="Tamil Nadu Government AI Scheme Assistant"
APP_VERSION="1.0.0"

# Options: development | staging | production
APP_ENV="development"

# Comma-separated list of allowed CORS origins.
# Production: set to your deployed frontend URL.
# Example: "https://tngov-ai.vercel.app,https://www.tngov-ai.vercel.app"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Frontend base URL (used for CORS headers and documentation links)
FRONTEND_URL="http://localhost:3000"

# ─── Database Configuration ───────────────────────────────────────────────────
# Development: local Docker PostgreSQL
# Production (Railway): auto-injected by Railway PostgreSQL plugin as DATABASE_URL
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/tngov_ai"

# ─── Vector Store (ChromaDB — Embedded, Persistent) ──────────────────────────
# Directory where ChromaDB persists the vector index.
# Production: must point to a Railway persistent volume mount path.
# Example: "/data/chroma_db"
CHROMA_DB_PATH="./chroma_db"

# Collection name inside ChromaDB. Do not change unless re-indexing from scratch.
CHROMA_COLLECTION_NAME="tn_gov_schemes"

# ─── BM25 Index ───────────────────────────────────────────────────────────────
# Path to pre-built BM25 index JSON file.
# Production: mounted via persistent volume alongside ChromaDB.
BM25_INDEX_PATH="./bm25_index.json"

# ─── Data Directory ───────────────────────────────────────────────────────────
# Root data directory containing source PDFs and processed chunks.
# Production: "/data"
DATA_DIR="../data"

# ─── Embedding Model ──────────────────────────────────────────────────────────
# Must match the model used during ingestion. Do not change without re-indexing.
EMBEDDING_MODEL="intfloat/multilingual-e5-large"

# ─── LLM Provider Configuration ──────────────────────────────────────────────
# Options: groq | openai | gemini
LLM_PROVIDER="groq"

# Groq (default — recommended for production: fast, free tier available)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# OpenAI (alternative)
OPENAI_API_KEY="sk-your_openai_api_key_here"
MODEL_NAME="gpt-4o-mini"

# Google Gemini (alternative)
GEMINI_API_KEY="AIzaSy_your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.0-flash"

# ─── LLM Tuning ───────────────────────────────────────────────────────────────
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
MAX_QUERY_LENGTH=500

# ─── Retrieval Tuning ─────────────────────────────────────────────────────────
RETRIEVAL_VECTOR_TOP_K=5
RETRIEVAL_BM25_TOP_K=5
RETRIEVAL_FINAL_CONTEXT_K=4
RETRIEVAL_MIN_SCORE=0.015
RRF_K=60

# ─── Server ───────────────────────────────────────────────────────────────────
BACKEND_HOST="0.0.0.0"
# Note: Railway auto-injects $PORT — the entrypoint.sh uses $PORT at runtime.
# This value is only used for local development.
BACKEND_PORT=8000
