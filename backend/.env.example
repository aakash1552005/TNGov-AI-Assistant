# ─── Application Configuration ────────────────────────────────
APP_NAME="Tamil Nadu Government AI Scheme Assistant"
APP_VERSION="1.0.0"
DEBUG=false
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ─── Database Configuration ────────────────────────────────────
# Development: SQLite (In-Memory or Local File)
# Production: PostgreSQL via AsyncPG
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/tngov_ai"

# ─── Vector Store & Embedding Configuration ───────────────────
CHROMA_PERSIST_DIR="data/chroma_db"
EMBEDDING_MODEL="intfloat/multilingual-e5-large"
CHUNKS_DIR="data/processed/chunks"
BM25_INDEX_DIR="data/processed/bm25"
RETRIEVAL_MIN_SCORE=0.15

# ─── LLM Provider Configuration ───────────────────────────────
# Options: groq | openai | gemini
LLM_PROVIDER="groq"

# Provider API Keys (Set key matching selected LLM_PROVIDER)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

OPENAI_API_KEY="sk-your_openai_api_key_here"
MODEL_NAME="gpt-4o-mini"

GEMINI_API_KEY="AIzaSy_your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.0-flash"

# ─── Performance & Safety Parameters ─────────────────────────
TEMPERATURE=0.1
MAX_TOKENS=1024
MAX_QUERY_LENGTH=500
